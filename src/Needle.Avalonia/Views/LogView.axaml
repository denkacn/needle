<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Needle.Avalonia.Controls"
             xmlns:converters="using:Needle.Avalonia.Converters"
             xmlns:vm="using:Needle.Avalonia.ViewModels"
             x:Class="Needle.Avalonia.Views.LogView"
             x:DataType="vm:MainViewModel"
             Focusable="True">
    <UserControl.Resources>
        <converters:HexBrushConverter x:Key="HexBrushConverter" />
    </UserControl.Resources>
    <Panel>
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   Text="Open or drag a local log file to start."
                   FontSize="16"
                   IsVisible="{Binding !Document.HasLines}" />

        <Grid ColumnDefinitions="*,Auto,Auto"
              RowDefinitions="*,Auto"
              IsVisible="{Binding Document.HasLines}">
            <ScrollViewer x:Name="LinesViewport"
                          Grid.Row="0"
                          Grid.Column="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <controls:LogTextView x:Name="LogText"
                                      Lines="{Binding Lines}"
                                      SelectedLineNumber="{Binding Document.SelectedLineNumber, Mode=TwoWay}"
                                      SelectedText="{Binding Document.SelectedText, Mode=TwoWay}"
                                      ToggleBookmarkCommand="{Binding ToggleBookmarkCommand}"
                                      GutterWidth="80"
                                      LineHeight="{Binding DisplaySettings.LogLineHeight}"
                                      TextFontSize="{Binding DisplaySettings.LogFontSize}"
                                      TextFontFamily="{Binding DisplaySettings.LogFontFamily}"
                                      TextBrush="{Binding DisplaySettings.LogTextColor, Converter={StaticResource HexBrushConverter}, ConverterParameter=#C2CBD6}"
                                      LineNumberBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                      SelectedLineBrush="{DynamicResource NeedleLogSelectedLineBrush}"
                                      TextSelectionBrush="{DynamicResource NeedleLogTextSelectionBrush}"
                                      BookmarkBackgroundBrush="{DynamicResource NeedleLogBookmarkBrush}"
                                      TriggerBackgroundBrush="{Binding DisplaySettings.TriggerHighlightColor, Converter={StaticResource HexBrushConverter}, ConverterParameter=#4A1F24}"
                                      GutterBrush="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
            </ScrollViewer>

            <controls:LogTimelineView x:Name="Timeline"
                                      Grid.Row="0"
                                      Grid.Column="1"
                                      Width="14"
                                      Margin="2,0,2,0"
                                      IsVisible="{Binding DisplaySettings.IsMiniMapEnabled}"
                                      Markers="{Binding Timeline.Markers}"
                                      TotalLineCount="{Binding Timeline.TotalLineCount}"
                                      ScrollLine="{Binding Document.TimelineScrollLine}"
                                      ViewportLineCount="{Binding Document.TimelineViewportLineCount}" />

            <ScrollBar Grid.Row="0"
                       Grid.Column="2"
                       Orientation="Vertical"
                       Minimum="0"
                       Maximum="{Binding Document.MaximumScrollLine}"
                       Value="{Binding Document.ScrollLine, Mode=TwoWay}"
                       ViewportSize="{Binding Document.ViewportLineCount}"
                       SmallChange="3"
                       LargeChange="{Binding Document.ViewportLineCount}"
                       IsEnabled="{Binding Document.IsDocumentOpen}" />

            <Border Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Padding="12,4"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Document.ViewportRange}"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Document.FollowTailButtonText}"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </Grid>
            </Border>
        </Grid>
    </Panel>
</UserControl>

